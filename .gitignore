.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local vector index and generated notes are build products, not source.
index/
notes/

# Corpus PDFs are public documents fetched from issuer sites, not repository content.
# corpus/manifest.json records where each one came from.
corpus/*.pdf
sample_pdf/*.pdf

# Never commit credentials.
.env
